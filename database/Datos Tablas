INSERT INTO linea_pedido (id_pedido, id_producto, id_variante, nombre_producto, descripcion_variante,
                          precio_unitario, cantidad)
SELECT pe.id_pedido, p.id_producto, vp.id_variante, p.marca || ' ' || p.nombre,
       c.nombre || ' · ' || a.nombre, p.precio + vp.precio_adicional, v.cantidad
FROM (VALUES
    ('UCS-2026-48213', 'ATLP120-NEG-MAT', 1),
    ('UCS-2026-48213', 'RTDSOM-MUL-BRI',  1),
    ('UCS-2026-73590', 'EDR1280-NOG-MAD', 1)
) AS v(numero_pedido, sku, cantidad)
JOIN pedido            pe ON pe.numero_pedido = v.numero_pedido
JOIN variante_producto vp ON vp.sku           = v.sku
JOIN producto          p  ON p.id_producto    = vp.id_producto
JOIN color             c  ON c.id_color       = vp.id_color
JOIN acabado           a  ON a.id_acabado     = vp.id_acabado;

